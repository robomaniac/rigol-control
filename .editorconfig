# EditorConfig — https://editorconfig.org
# Matches the conventions already in the tree: 4-space Python, 2-space
# JS/CSS/YAML/JSON, LF line endings, a final newline everywhere.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,yml,yaml,json,qmd,typ}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break.
trim_trailing_whitespace = false

[*.csv]
# Python's csv module writes RFC 4180 CRLF records; the committed measurement
# CSVs under Data/ keep them so they round-trip byte for byte.
end_of_line = crlf
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
